# User service (~/.config/systemd/user): the simulator, fullscreen on the
# desktop the Pi logs in to. Install with ./deploy.sh kiosk.
# Logs: journalctl --user -u display-simulator
[Unit]
Description=LED display simulator, fullscreen
# Keeps retrying while the desktop is still starting
StartLimitIntervalSec=0

[Service]
ExecStart=%h/display-server/simulate.sh --fullscreen
WorkingDirectory=%h/display-server
# The desktop's Wayland display; without it (desktop not up yet) the start
# fails and is retried
Environment=WAYLAND_DISPLAY=wayland-0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
