# User service (~/.config/systemd/user): shows the demos in turn on the
# simulator. Install with ./deploy.sh kiosk.
# Logs: journalctl --user -u demo-cycle
[Unit]
Description=Demo loop on the LED display
BindsTo=display-simulator.service
After=display-simulator.service
StartLimitIntervalSec=0

[Service]
# Seconds per demo
ExecStart=%h/display-server/demos/cycle.sh 60
Restart=always
RestartSec=3

[Install]
WantedBy=display-simulator.service
